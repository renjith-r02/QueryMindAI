# Copy to .env and fill in. Real environment variables override these values.

# Gemini API key (https://aistudio.google.com/apikey). GOOGLE_API_KEY also works.
GEMINI_API_KEY=AQ.Ab8RN6JgZHEfT_4vcY9eyC5KkTyke6pvNC0ge67rex2Rz8vl3g

# Embedding provider: gemini (default) or fastembed (local, no key)
EMBEDDING_PROVIDER=gemini
# Leave unset to use the provider default (gemini-embedding-001 / BAAI/bge-small-en-v1.5)
# EMBEDDING_MODEL=gemini-embedding-001
# Gemini output size: 768, 1536 or 3072. Changing it requires `index --recreate`.
EMBEDDING_DIM=768

# Model that writes the SQL and the final answer in `ask` / `run`: gemini (default) or openai.
LLM_PROVIDER=gemini
# Leave unset to use the provider default (gemini-3.8-flash / gpt-6-luna).
# LLM_MODEL applies to the selected provider; OPENAI_MODEL / GEMINI_MODEL only to their own.
# LLM_MODEL=
# OPENAI_MODEL=gpt-6-luna
# OpenAI reasoning effort: none, low, medium, high, xhigh, max (unset = the model's default).
# LLM_REASONING_EFFORT=

# OpenAI API key (https://platform.openai.com/api-keys), needed when LLM_PROVIDER=openai.
# Embeddings still use EMBEDDING_PROVIDER below, so Gemini embeddings still need GEMINI_API_KEY.
OPENAI_API_KEY=

# Database connections for `run`: QUERYMIND_DB_<NAME> where NAME is the database name used
# in the schema files. Prefer a read-only user; queries also run in read-only transactions.
QUERYMIND_DB_ECOMMERCE=mysql+pymysql://readonly:password@localhost:3306/ecommerce
QUERYMIND_DB_RETURNS_DB=postgresql+psycopg://readonly:password@localhost:5432/returns_db
# QUERYMIND_MAX_ROWS=1000
# QUERYMIND_QUERY_TIMEOUT=30

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=querymind_knowledge
# QDRANT_API_KEY=

# Semantic cache: answer a recent, near-identical question without calling the LLM.
# Questions that are identical after normalising case/punctuation always match; otherwise the
# embedding similarity must reach the threshold AND numbers, quoted values and time/direction/
# negation words must be equal. Measured with gemini-embedding-001: paraphrases ~0.91-0.93,
# different questions <= 0.85. 0.95 reuses only near-exact repeats; ~0.90 also reuses paraphrases.
# QUERYMIND_CACHE_ENABLED=true
# QUERYMIND_CACHE_THRESHOLD=0.95
# QUERYMIND_CACHE_TTL=3600
