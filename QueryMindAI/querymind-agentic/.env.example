# Copy to .env and fill in. Real environment variables override these values.

# Gemini API key (https://aistudio.google.com/apikey). GOOGLE_API_KEY also works.
GEMINI_API_KEY=<Gemini Key>

# Embedding provider: gemini (default) or fastembed (local, no key)
EMBEDDING_PROVIDER=gemini
# Leave unset to use the provider default (gemini-embedding-001 / BAAI/bge-small-en-v1.5)
# EMBEDDING_MODEL=gemini-embedding-001
# Gemini output size: 768, 1536 or 3072. Changing it requires `index --recreate`.
EMBEDDING_DIM=768

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=querymind_knowledge
# QDRANT_API_KEY=

# Local Docker databases (admin users; queries run in read-only transactions)
QUERYMIND_DB_ECOMMERCE=mysql+pymysql://root:your_secure_password@localhost:3306/ecommerce
QUERYMIND_DB_RETURNS_DB=postgresql+psycopg://postgres:admin@localhost:5432/postgres


OPENAI_API_KEY=open ai key
OPENAI_MODEL=open ai model
