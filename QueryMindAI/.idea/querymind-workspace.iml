<?xml version="1.0" encoding="UTF-8"?>
<module type="PYTHON_MODULE" version="4">
  <!-- Project root: querymind-ui and top-level files. The Python projects are their own modules. -->
  <component name="NewModuleRootManager">
    <content url="file://$MODULE_DIR$">
      <excludeFolder url="file://$MODULE_DIR$/querymind-ui/node_modules" />
      <excludeFolder url="file://$MODULE_DIR$/querymind-ui/dist" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
  </component>
</module>
