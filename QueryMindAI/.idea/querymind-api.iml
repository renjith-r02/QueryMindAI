<?xml version="1.0" encoding="UTF-8"?>
<module external.system.id="pyproject.toml" type="PYTHON_MODULE" version="4">
  <component name="NewModuleRootManager">
    <content url="file://$MODULE_DIR$/querymind-api">
      <sourceFolder url="file://$MODULE_DIR$/querymind-api" isTestSource="false" />
      <sourceFolder url="file://$MODULE_DIR$/querymind-api/tests" isTestSource="true" />
      <excludeFolder url="file://$MODULE_DIR$/querymind-api/.venv" />
      <excludeFolder url="file://$MODULE_DIR$/querymind-api/.pytest_cache" />
      <excludeFolder url="file://$MODULE_DIR$/querymind-api/querymind_api.egg-info" />
