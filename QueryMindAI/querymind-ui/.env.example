# Copy to .env.local. Restart `npm run dev` after changing it.

# Base URL of querymind-api (e.g. http://localhost:8000). Questions on the Ask page
# are sent to its POST /run endpoint. Leave empty to use the built-in mock backend.
VITE_API_URL=

# Force the mock backend even when VITE_API_URL is set ("true" / "false").
VITE_USE_MOCKS=
