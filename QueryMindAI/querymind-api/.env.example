# Copy to .env. Real environment variables override these values.
# QueryMind settings are read from querymind-agentic/.env unless set here or in the environment:
# GEMINI_API_KEY (the default LLM, gemini-3.8-flash, and embeddings), OPENAI_API_KEY (if LLM_PROVIDER=openai),
# LLM_PROVIDER / LLM_MODEL to change the model, Qdrant and database connections.

# Comma-separated origins allowed to call the API from a browser (the UI dev server by default).
QUERYMIND_CORS_ORIGINS=http://localhost:8080

# Extra hosts the Okta connection test may call, for a custom Okta domain (comma-separated).
# QUERYMIND_OKTA_ALLOWED_HOSTS=login.example.com

# Okta settings (OKTA_*) are written here by Admin -> Okta SSO.
